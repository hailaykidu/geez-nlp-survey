# Ge'ez-Script NLP Tools Survey Configuration
# Copy this file to .env and fill in your credentials

# Zotero API Configuration
ZOTERO_API_KEY=your_api_key_here
ZOTERO_LIBRARY_ID=your_library_id_here

# Output directory (optional)
GEEZ_NLP_OUTPUT=/mnt/user-data/outputs/geez_nlp_extraction

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Pipeline phases to run (search,screen,code,export)
PIPELINE_PHASES=search,screen,code,export

# Search parameters
ARXIV_MAX_RESULTS=100
SEMANTIC_SCHOLAR_MAX_RESULTS=100

# Rate limiting (requests per second)
ARXIV_RATE_LIMIT=2
SEMANTIC_SCHOLAR_RATE_LIMIT=1

# Timeout settings (seconds)
REQUEST_TIMEOUT=10
SEARCH_TIMEOUT=300
