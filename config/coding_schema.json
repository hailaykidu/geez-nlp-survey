    "description": "Extraction and coding schema for Ge'ez-Script NLP papers",
    "created": "2026-09-11"
  },
  "dimensions": {
    "languages": {
      "description": "Target languages of the paper",
      "type": "multi_select",
      "values": [
        "Amharic",
        "Tigrinya",
        "Classical Ge'ez",
        "Other Ge'ez-script language"
      ]
    },
    "primary_pillar": {
      "description": "Primary foundational NLP category",
      "type": "single_select",
      "values": [
        "Tokenization & Normalization",
        "Lexical & Morphological Analysis",
        "Text Representation & Embeddings",
        "Sequence Labeling & Structure Extraction",
        "Unclear"
      ],
      "definitions": {
        "Tokenization & Normalization": "Unicode normalization, character-level processing, word/morpheme segmentation",
        "Lexical & Morphological Analysis": "Root extraction, morphological decomposition, lemmatization, POS tagging",
        "Text Representation & Embeddings": "Word embeddings, contextual embeddings, language model pretraining",
        "Sequence Labeling & Structure Extraction": "NER, chunking, syntactic parsing, relation extraction"
      }
    },
