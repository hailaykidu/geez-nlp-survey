  "discussions": {
    "Amharic-Tokenizer": {
      "strengths": [
        "Well-maintained by community (100+ GitHub stars)",
        "Handles complex Amharic word boundaries"
      ],
      "design_tradeoffs": [
        "Single-language focus: depth over breadth (intentional for Amharic expertise)",
        "Rule-based approach prioritizes interpretability"
      ],
      "field_significance": "Establishes tokenization baseline for Ge'ez-script languages; enables downstream processing"
    },
    "HornMorpho": {
      "strengths": [
        "Rare cross-language morphological coverage",
        "Addresses complex templatic morphology",
        "Active development"
      ],
      "design_tradeoffs": [
        "Rule-based approach prioritizes interpretability over neural methods",
        "Requires extensive linguistic rules"
      ],
      "field_significance": "Establishes morphological baseline for Ge'ez-script languages; enables downstream tasks like NER"
    },
    "semitic-scattering-law": {
      "strengths": [
        "Algorithmic innovation for Semitic morphology",
        "Neural approach complements rule-based tools"
      ],
      "design_tradeoffs": [
        "Neural approach trades interpretability for potential accuracy",
        "Requires morphologically annotated data"
      ],
      "field_significance": "Contributes novel morphological baseline; represents emerging neural methods"
    },
    "Tigrinya-PLMs": {
      "strengths": [
        "Rare Tigrinya-specific PLM",
        "Enables transfer learning for low-resource language"
      ],
      "design_tradeoffs": [
        "Single-language: prioritizes Tigrinya depth",
        "Requires large corpus for pre-training"
      ],
      "field_significance": "Rare contribution to underrepresented languages; addresses critical research gap"
    },
    "TLMD: Tigrinya Language Modeling Dataset": {
      "strengths": [
        "Rare Tigrinya dataset",
